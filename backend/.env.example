# PostgreSQL is the production default. SQLite is useful for an instant local demo.
DATABASE_URL=postgresql+psycopg2://pantheon:change-me@localhost:5432/pantheon
# A long shared secret used by the Chrome extension and agent service.
PANTHEON_API_KEY=replace-with-a-long-random-secret
# Set true only for an unauthenticated local prototype.
ALLOW_INSECURE_LOCALHOST=false
# Comma-separated origins allowed to call the API from a browser UI.
CORS_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID
# Simple per-IP API protection for this MVP. Use a shared limiter in production.
RATE_LIMIT_PER_MINUTE=120
