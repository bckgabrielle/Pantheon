GROQ_API_KEY=replace-me
AGENT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

PANTHEON_API_KEY=replace-with-a-long-random-secret
BACKEND_API_KEY=replace-with-a-long-random-secret
BACKEND_USER_ID=default

DATABASE_URL=sqlite:///./pantheon.db
ALLOW_INSECURE_LOCALHOST=false
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID

VITE_AGENT_BASE_URL=http://localhost:8000
VITE_BACKEND_BASE_URL=http://localhost:8001
VITE_PANTHEON_API_KEY=replace-with-a-long-random-secret
VITE_BACKEND_USER_ID=default
VITE_AGENT_SESSION_ID=ui-local-session
VITE_USE_MOCK=false
