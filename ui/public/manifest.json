{
  "manifest_version": 3,
  "name": "Tab Agent",
  "version": "0.1.0",
  "description": "An AI agent reviews your open tabs and proposes cleanup actions — you approve before anything happens.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Tab Agent"
  },
  "permissions": ["tabs", "sessions", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
